{
  // Generated by `next build`, then edited in two places - `strict` turned on
  // and `paths` added. Both edits are deliberate and both are load-bearing; see
  // the notes below.
  //
  // Do not tidy anything OUT of this file. `next build` reads it, and any
  // setting it expects and cannot find is written back in - reformatting the
  // whole file on the way through, blank lines and all. Dropping `allowJs`
  // during the Phase 1 port was reverted by the very next build, with
  // "We detected TypeScript in your project and reconfigured your tsconfig.json
  // file for you" as the only warning.
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],

    // Next's, not ours, and it changes nothing here: `include` below names no
    // `.js` pattern, so there is no JavaScript for tsc to allow. The two
    // remaining `.js` files in the repo are config that Node runs directly.
    // `checkJs` stays off for the same reason.
    "allowJs": true,

    "skipLibCheck": true,

    // CHANGED from the generated `false`.
    //
    // The engine's core rule is "parse, don't validate": untrusted input is
    // narrowed once at the boundary into a branded `ValidSchedule`, and nothing
    // downstream re-checks it. That guarantee is enforced entirely by the type
    // system, and without `strict` the two things holding it up - `null` checks
    // and no implicit `any` - are both off. A non-strict build would let an
    // unvalidated schedule reach the countdown and still compile.
    "strict": true,

    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    // ADDED. AGENTS.md requires `@/` over deep relative imports, and Next reads
    // `paths` from here directly - no bundler alias needed.
    //
    // Deliberately WITHOUT `baseUrl`: TypeScript 6 deprecates it and errors
    // outright (TS5101), and it is no longer needed - `paths` entries resolve
    // relative to this file's directory on their own.
    "paths": {
      "@/*": ["./src/*"]
    },

    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
